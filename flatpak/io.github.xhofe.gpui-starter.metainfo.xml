  <name>GPUI Starter</name>
  <summary>Native desktop app starter built with Rust and GPUI</summary>

  <developer id="io.github.xhofe">
    <name>Andy Hsu</name>
  </developer>

  <description>
    <p>
      GPUI Starter is a native, GPU-accelerated desktop app template built in
      Rust with GPUI, the rendering engine behind the Zed editor. Clone it, run
      ./scripts/init.sh my-app, and start building.
    </p>
    <p>The shell includes Home, a redb-backed Todos demo, Settings (theme,
      language, fonts, proxy, updates, tray), a command palette, workspace tabs,
      and packaging CI for macOS, Windows and Linux.</p>
  </description>

  <launchable type="desktop-id">io.github.xhofe.gpui-starter.desktop</launchable>

  <url type="homepage">https://github.com/xhofe/gpui-starter</url>
  <url type="bugtracker">https://github.com/xhofe/gpui-starter/issues</url>
